from pathlib import Path

from snakemake.exceptions import WorkflowError
from snakemake.utils import min_version

##### minimum snakemake version #####
min_version("8.8.0")

configfile: Path(workflow.basedir) / "config.yaml"

for _key in ("sif_dir", "db_dir", "data_dir"):
    if not config.get(_key):
        raise WorkflowError(
            f"config '{_key}' is not set; pass config/paths.yaml as the last --configfile "
            "(template: config/paths.yaml.example)"
        )

##### resolve paths #####
SIF = Path(config["sif_dir"])
DB = Path(config["db_dir"])
DATA = Path(config["data_dir"])
HOST = config["host"]["name"]
SCRIPTS = Path(workflow.basedir) / "scripts"

# Outputs are relative to the Snakemake working directory (--directory <run dir>).
# Per-assembly-type intermediates under {assembly_type}_temp; type-independent ones under shared_temp.
TMP = Path("{assembly_type}_temp")
SHARED = Path("shared_temp")
RES = Path("result")

ASSEMBLY_TYPES = config["assembly_types"]
_unknown = set(ASSEMBLY_TYPES) - {"hybrid", "illumina"}
if _unknown:
    raise WorkflowError(f"unknown assembly_types: {sorted(_unknown)}")

COMP = config["thresholds"]["completeness"]
CONT = config["thresholds"]["contamination"]
REFINED = f"metawrap_{COMP}_{CONT}_bins"


def sif(name):
    return str(SIF / config["containers"][name])


def res(rule_name, key):
    return config["resources"][rule_name][key]


def mem_gb(wildcards, resources):
    return max(1, resources.mem_mb // 1024)


def ont_reads(wildcards):
    # Only the hybrid assembly uses ONT reads.
    return rules.nano_dehost.output.fq if wildcards.assembly_type == "hybrid" else []


def nanopore_flag(wildcards, input):
    return f"--nanopore {input.ont}" if wildcards.assembly_type == "hybrid" else ""


##### samples #####
SAMPLE_SHEET = DATA / config["samples"]
if not SAMPLE_SHEET.is_file():
    raise WorkflowError(f"sample sheet not found: {SAMPLE_SHEET}")
with open(SAMPLE_SHEET) as f:
    next(f)
    SAMPLES = [l.split()[0] for l in f if l.strip()]
if not SAMPLES:
    raise WorkflowError(f"no samples in {SAMPLE_SHEET}")

wildcard_constraints:
    sample="|".join(SAMPLES),
    assembly_type="hybrid|illumina",
    platform="illumina|ont",


##### load rules #####

include: "rules/databases.smk"
include: "rules/nano_dehost.smk"
include: "rules/read_qc.smk"
include: "rules/read_stats.smk"
include: "rules/assembly.smk"
include: "rules/binning.smk"
include: "rules/bin_refinement.smk"
include: "rules/reassembly.smk"
include: "rules/summarize_bins.smk"
include: "rules/dereplication.smk"
include: "rules/mag_coverage.smk"

##### entry point #####
rule all:
    default_target: True
    input:
        rules.databases.input,
        expand(SHARED / "read_qc" / "{sample}" / "fastp.json", sample=SAMPLES),
        # ONT stats only when an assembly type uses ONT reads.
        expand(
            rules.read_stats.output,
            sample=SAMPLES,
            platform=["illumina", "ont"] if "hybrid" in ASSEMBLY_TYPES else ["illumina"],
        ),
        expand(
            TMP / "bin_refinement" / "{sample}" / f"{REFINED}.contigs.tsv",
            sample=SAMPLES,
            assembly_type=ASSEMBLY_TYPES,
        ),
        expand(rules.summarize_bins.output, assembly_type=ASSEMBLY_TYPES),
        expand(rules.drep.output.final, assembly_type=ASSEMBLY_TYPES),
        expand(rules.mag_coverage.output.table, assembly_type=ASSEMBLY_TYPES),
